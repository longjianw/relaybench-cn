{
  "name": "relaybench-cn",
  "version": "0.2.1",
  "description": "本地优先的中文 LLM/Codex 供应商对比评测工具",
  "author": "Long Jianwei",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "bundle:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=desktop/server.cjs",
    "desktop:prepare": "node scripts/prepare-desktop-package.mjs",
    "desktop:build": "npm run build && npm run bundle:server && npm run desktop:prepare",
    "dist:mac": "npm run desktop:build && electron-builder --projectDir .desktop-package --config ../electron-builder.yml --mac dmg --arm64",
    "app:install": "zsh scripts/build-macos-app.sh",
    "app:stop": "zsh scripts/stop-local-app.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "smol-toml": "^1.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
